---
import { Icon } from 'astro-icon/components';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="w-full border-b-2 border-primary">
  {
    items.map((it) => (
      <details class="group border-t-2 border-primary">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-[1.15rem] font-bold text-primary [&::-webkit-details-marker]:hidden">
          {it.q}
          <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-sm bg-primary text-accent">
            <Icon name="ph:plus-bold" class="transition-transform duration-200 group-open:rotate-45" />
          </span>
        </summary>
        <p class="max-w-[40rem] pb-6 text-[1.05rem] leading-relaxed text-muted">{it.a}</p>
      </details>
    ))
  }
</div>
