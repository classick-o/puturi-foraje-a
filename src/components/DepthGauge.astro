---
// Tubul de foraj de pe marginea stanga: se umple cu apa pe masura ce cobori,
// iar indicatorul arata "adancimea" la care ai ajuns in pagina.
---

<div id="depth-gauge" class="pointer-events-none fixed bottom-0 left-0 top-0 z-30 w-[5px] print:hidden lg:w-[7px]" aria-hidden="true">
  <div class="absolute inset-0 bg-primary/10"></div>
  <div data-fill class="absolute inset-x-0 top-0 h-0 bg-secondary"></div>
  <div
    data-chip
    class="absolute left-[10px] top-0 hidden -translate-y-1/2 whitespace-nowrap rounded-sm bg-primary px-1.5 py-0.5 font-display text-sm font-bold tabular-nums text-white min-[1320px]:block"
  >
    0 m
  </div>
</div>

<script>
  const gauge = document.getElementById('depth-gauge');
  const fill = gauge?.querySelector<HTMLElement>('[data-fill]');
  const chip = gauge?.querySelector<HTMLElement>('[data-chip]');
  const MAX_DEPTH = 60; // metri "la final de pagina"
  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    if (fill) fill.style.height = `${p * 100}%`;
    if (chip) {
      chip.style.top = `${Math.max(2, p * 100)}%`;
      chip.textContent = p > 0.97 ? 'apă' : `-${Math.round(p * MAX_DEPTH)} m`;
    }
  };
  addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
