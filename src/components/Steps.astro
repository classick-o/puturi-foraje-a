---
import { steps } from '../lib/site';
---

<ol class="relative">
  <span class="absolute bottom-4 left-[13px] top-2 w-[6px] bg-secondary" aria-hidden="true"></span>
  {
    steps.map((s, i) => (
      <li class="relative grid grid-cols-[32px_1fr] gap-x-4 pb-8 last:pb-0">
        <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-sm bg-primary font-display text-xl font-black text-accent">
          {i + 1}
        </span>
        <div>
          <h3 class="text-[1.6rem]">{s.title}</h3>
          <p class="mt-1 max-w-[36rem] text-muted">{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>
