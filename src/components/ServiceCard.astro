---
import { Icon } from 'astro-icon/components';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  icon: string;
  excerpt: string;
}
const { slug, title, icon, excerpt } = Astro.props;
---

<a href={withBase(`servicii/${slug}`)} class="group flex gap-4 border-t-2 border-primary py-5">
  <Icon name={icon} class="mt-1 shrink-0 text-[1.7rem] text-secondary" />
  <span>
    <span class="block font-display text-[1.75rem] font-extrabold leading-tight text-primary decoration-secondary decoration-2 underline-offset-4 group-hover:underline">
      {title}
    </span>
    <span class="mt-1 block text-muted">{excerpt}</span>
  </span>
</a>
