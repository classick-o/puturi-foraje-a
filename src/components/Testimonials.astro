---
import { testimonials } from '../lib/site';

interface Props {
  limit?: number;
}
const { limit = 3 } = Astro.props;
---

<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
  {
    testimonials.slice(0, limit).map((t) => (
      <figure class="border-l-[6px] border-loess pl-5">
        <blockquote class="text-[1.15rem] leading-relaxed">„{t.text}”</blockquote>
        <figcaption class="mt-2 font-bold text-muted">
          {t.name}, {t.city}
        </figcaption>
      </figure>
    ))
  }
</div>
