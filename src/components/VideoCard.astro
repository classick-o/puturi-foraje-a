---
// Card video vertical: doar posterul pana la clic (zero MB), apoi porneste inline cu sunet.
import { Icon } from 'astro-icon/components';
import { type Video, videoSrc, videoPoster } from '../lib/media';

interface Props {
  video: Video;
  class?: string;
}
const { video, class: cls = '' } = Astro.props;
---

<figure class:list={['group', cls]}>
  <div class="video-card relative aspect-[9/16] overflow-hidden rounded-[14px] bg-primary">
    <video
      class="h-full w-full object-cover"
      src={videoSrc(video)}
      poster={videoPoster(video)}
      preload="none"
      playsinline
      title={video.title}
    ></video>
    <button
      type="button"
      class="video-play absolute inset-0 flex items-end justify-start p-4"
      aria-label={`Pornește filmarea: ${video.title}`}
    >
      <span class="inline-flex items-center gap-2 rounded-md bg-accent py-2 pl-3 pr-4 font-bold text-primary shadow-lg">
        <Icon name="ph:play-fill" class="text-xl" />
        0:{String(video.seconds).padStart(2, '0')}
      </span>
    </button>
  </div>
  <figcaption class="mt-3 text-[1.02rem] font-bold leading-snug text-primary">{video.title}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
    const video = card.querySelector('video');
    const btn = card.querySelector<HTMLButtonElement>('.video-play');
    btn?.addEventListener('click', () => {
      document.querySelectorAll<HTMLVideoElement>('.video-card video').forEach((v) => v !== video && v.pause());
      video?.setAttribute('controls', '');
      video?.play();
      btn.remove();
    });
  });
</script>
