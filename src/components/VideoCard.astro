---
// Card video vertical: arata doar posterul (zero MB pana la clic), apoi
// porneste filmarea inline cu sunet si controale.
import { Icon } from 'astro-icon/components';
import { type Video, videoSrc, videoPoster } from '../lib/media';

interface Props {
  video: Video;
  class?: string;
}
const { video, class: cls = '' } = Astro.props;
---

<figure class:list={['group overflow-hidden rounded-xl bg-primary shadow-md', cls]}>
  <div class="video-card relative aspect-[9/16] overflow-hidden">
    <video
      class="h-full w-full object-cover"
      src={videoSrc(video)}
      poster={videoPoster(video)}
      preload="none"
      playsinline
      title={video.title}
    ></video>
    <button
      type="button"
      class="video-play absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gradient-to-t from-primary/85 via-primary/10 to-transparent text-white"
      aria-label={`Porneste filmarea: ${video.title}`}
    >
      <span
        class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-accent text-primary shadow-lg transition-transform group-hover:scale-110"
      >
        <Icon name="ph:play-fill" class="ml-1 text-3xl" />
      </span>
      <span class="absolute left-3 top-3 rounded-md bg-primary/80 px-2 py-1 text-xs font-semibold">
        {video.tag} &middot; 0:{String(video.seconds).padStart(2, '0')}
      </span>
    </button>
  </div>
  <figcaption class="px-4 py-3 text-sm font-semibold leading-snug text-white">{video.title}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
    const video = card.querySelector('video');
    const btn = card.querySelector<HTMLButtonElement>('.video-play');
    btn?.addEventListener('click', () => {
      // Opreste alte filmari care ruleaza
      document.querySelectorAll<HTMLVideoElement>('.video-card video').forEach((v) => v !== video && v.pause());
      video?.setAttribute('controls', '');
      video?.play();
      btn.remove();
    });
  });
</script>
