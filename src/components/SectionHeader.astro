---
interface Props {
  eyebrow?: string; // pastrat pentru compatibilitate, nu se afiseaza
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { title, subtitle, class: cls = '' } = Astro.props;
---

<div class={`max-w-3xl ${cls}`}>
  <h2 class="text-[2.7rem] sm:text-[3.6rem]">{title}</h2>
  {subtitle && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{subtitle}</p>}
</div>
