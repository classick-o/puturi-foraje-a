---
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';
---

<!-- Mobil: bara fixa jos. Majoritatea clicurilor din Google Ads vin de pe telefon. -->
<div class="fixed inset-x-0 bottom-0 z-40 bg-primary px-3 pb-[calc(0.55rem+env(safe-area-inset-bottom))] pt-2.5 sm:hidden print:hidden">
  <div class="flex gap-2">
    <a
      href={site.phoneHref}
      data-cta="bara-mobil"
      class="flex flex-1 items-center justify-center gap-2.5 rounded-md bg-accent py-2.5 text-primary active:bg-accent-hover"
    >
      <Icon name="ph:phone-fill" class="text-2xl" />
      <span class="leading-none">
        <span class="block text-[0.8rem] font-bold">Sună acum, e gratuit</span>
        <span class="block font-display text-[1.65rem] font-black tabular-nums">{site.phone}</span>
      </span>
    </a>
    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      data-cta="bara-mobil"
      aria-label="Scrie-ne pe WhatsApp"
      class="flex w-[64px] flex-col items-center justify-center gap-0.5 rounded-md bg-whatsapp text-white"
    >
      <Icon name="ph:whatsapp-logo-fill" class="text-[1.7rem]" />
      <span class="text-[0.7rem] font-bold">WhatsApp</span>
    </a>
  </div>
</div>

<!-- Desktop: WhatsApp flotant -->
<a
  href={site.whatsapp}
  target="_blank"
  rel="noopener"
  data-cta="flotant"
  aria-label="Scrie pe WhatsApp"
  class="fixed bottom-6 right-6 z-40 hidden items-center gap-2 rounded-md bg-whatsapp py-3 pl-3.5 pr-4 font-bold text-white shadow-lg hover:bg-[#178a45] sm:inline-flex print:hidden"
>
  <Icon name="ph:whatsapp-logo-fill" class="text-2xl" />
  WhatsApp
</a>
