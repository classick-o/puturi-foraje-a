---
import Strata from './Strata.astro';

interface Props {
  eyebrow?: string; // pastrat pentru compatibilitate, nu se afiseaza
  title: string;
  subtitle?: string;
  breadcrumb?: { label: string; href?: string }[];
}
const { title, subtitle, breadcrumb = [] } = Astro.props;

// Breadcrumb doar pentru SEO (BreadcrumbList JSON-LD), nu se afiseaza in UI.
const crumbLd =
  breadcrumb.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.label,
          ...(b.href ? { item: new URL(b.href, Astro.site).href } : {}),
        })),
      }
    : null;
---

<section class="soil-texture text-[#F2F4EF]">
  <div class="wrap py-12 sm:py-20">
    <h1 class="max-w-4xl text-[3rem] !text-[#F2F4EF] sm:text-[4.6rem]">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-[1.15rem] leading-relaxed text-[#F2F4EF]/80">{subtitle}</p>}
  </div>
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
</section>
<Strata layer="soil" />
