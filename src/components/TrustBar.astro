---
import { stats } from '../lib/site';

interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'light', class: cls = '' } = Astro.props;
const onDark = variant === 'dark';
---

<dl class={`grid grid-cols-2 gap-y-6 border-y-2 py-6 lg:grid-cols-4 ${onDark ? 'border-white/30' : 'border-primary'} ${cls}`}>
  {
    stats.map((s) => (
      <div class="px-1">
        <dt class={`order-2 text-[0.95rem] ${onDark ? 'text-white/70' : 'text-muted'}`}>{s.label}</dt>
        <dd class={`font-display text-[2.6rem] font-black leading-none tabular-nums ${onDark ? 'text-accent' : 'text-primary'}`}>{s.value}</dd>
      </div>
    ))
  }
</dl>
