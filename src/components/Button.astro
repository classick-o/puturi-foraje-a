---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  variant?: 'cta' | 'primary' | 'outline' | 'outline-light' | 'ghost';
  size?: 'md' | 'lg';
  icon?: string;
  iconRight?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconRight,
  type = 'button',
  class: cls = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-bold rounded-md transition-colors duration-150 disabled:opacity-60 disabled:pointer-events-none';

const sizes: Record<string, string> = {
  md: 'text-[1rem] px-5 py-2.5',
  lg: 'text-[1.05rem] px-6 py-3.5',
};

const variants: Record<string, string> = {
  cta: 'bg-accent text-primary hover:bg-accent-hover shadow-[0_3px_0_#b38c00]',
  primary: 'bg-secondary text-white hover:bg-secondary-hover shadow-[0_3px_0_#0b4a86]',
  outline: 'border-2 border-primary text-primary hover:bg-primary hover:text-white',
  'outline-light': 'border-2 border-white/60 text-white hover:bg-white hover:text-primary',
  ghost: 'text-primary underline decoration-2 underline-offset-4 decoration-secondary hover:decoration-primary',
};

const cl = [base, sizes[size], variants[variant], cls].join(' ');
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type };
---

<Tag class={cl} {...attrs} {...rest}>
  {icon && <Icon name={icon} class="text-[1.15em]" />}
  <slot />
  {iconRight && <Icon name={iconRight} class="text-[1.15em]" />}
</Tag>
