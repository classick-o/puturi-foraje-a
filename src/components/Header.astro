---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { site, nav } from '../lib/site';
import { withBase } from '../lib/url';
import Button from './Button.astro';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const homeHref = withBase('').replace(/\/+$/, '') || '/';
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  if (h === homeHref) return current === homeHref;
  return current === h || current.startsWith(h + '/');
};
---

<header id="site-header" class="sticky top-0 z-50 border-b-2 border-primary bg-surface">
  <div class="wrap flex h-[60px] items-center justify-between gap-4 lg:h-[68px]">
    <a href={withBase('')} class="flex items-center" aria-label={`${site.name} - prima pagină`}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigatie principala">
      {
        nav.map((item) =>
          item.label === 'Servicii' ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={['flex items-center gap-1 px-2.5 py-2 font-bold', isActive(item.href) ? 'text-secondary' : 'text-primary hover:text-secondary']}
              >
                Servicii
                <Icon name="ph:caret-down-bold" class="text-xs" />
              </a>
              <div class="invisible absolute left-0 top-full w-80 pt-2 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <div class="border-2 border-primary bg-surface py-1 shadow-lg">
                  {services.map((s) => (
                    <a
                      href={withBase(`servicii/${s.id}`)}
                      class="flex items-center gap-3 px-4 py-2.5 text-primary hover:bg-accent"
                    >
                      <Icon name={s.data.icon} class="text-lg text-secondary" />
                      {s.data.title}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={['px-2.5 py-2 font-bold', isActive(item.href) ? 'text-secondary' : 'text-primary hover:text-secondary']}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.phoneHref}
        data-cta="header"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-3.5 py-2 font-display text-xl font-extrabold tabular-nums text-primary shadow-[0_3px_0_#b38c00] hover:bg-accent-hover"
      >
        <Icon name="ph:phone-fill" class="text-lg" />
        <span class="sm:hidden">Sună</span>
        <span class="hidden sm:inline">{site.phone}</span>
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center text-primary lg:hidden"
        aria-label="Deschide meniul"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon id="menu-icon-open" name="ph:list-bold" class="text-[1.7rem]" />
        <Icon id="menu-icon-close" name="ph:x-bold" class="hidden text-[1.7rem]" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-x-0 bottom-0 top-[60px] z-40 hidden overflow-y-auto bg-primary/60 lg:hidden">
  <div class="border-b-2 border-primary bg-surface">
    <nav class="wrap flex flex-col py-4" aria-label="Meniu mobil">
      {
        nav.map((item) => (
          <a href={item.href} class="border-b border-border py-3.5 font-display text-[1.7rem] font-extrabold text-primary last:border-0">
            {item.label}
          </a>
        ))
      }
      <div class="mt-4 grid gap-2 pb-2">
        <Button href={site.phoneHref} variant="cta" size="lg" icon="ph:phone-fill" data-cta="meniu-mobil">Sună: {site.phone}</Button>
        <Button href={withBase('contact')} variant="outline">Cere ofertă scrisă</Button>
      </div>
    </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Inchide meniul' : 'Deschide meniul');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    // Blocheaza scroll-ul paginii cat timp meniul e deschis
    document.body.classList.toggle('overflow-hidden', open);
  };

  btn?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? true));

  // Inchide meniul la trecerea pe desktop
  const mq = window.matchMedia('(min-width: 1024px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });


</script>
