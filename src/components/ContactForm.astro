---
import Button from './Button.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { site } from '../lib/site';
import { tracking } from '../lib/tracking';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const inputCls =
  'w-full rounded-md border border-border bg-surface px-3.5 py-2.5 text-ink transition-colors placeholder:text-muted/60 focus:border-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/35';
const labelCls = 'mb-1.5 block text-sm font-medium text-primary';
---

<form
  id="contact-form"
  class="rounded-xl border border-border bg-surface p-6 shadow-sm sm:p-8"
  novalidate
  data-w3f-key={tracking.web3formsKey}
  data-wa={site.whatsappBase}
  data-site={site.name}
>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class={labelCls} for="nume">Nume</label>
      <input id="nume" name="nume" autocomplete="name" class={inputCls} placeholder="Numele tau" />
    </div>
    <div>
      <label class={labelCls} for="telefon">Telefon <span class="text-secondary">*</span></label>
      <input id="telefon" name="telefon" type="tel" required autocomplete="tel" inputmode="tel" pattern="[0-9+ ().-]{10,}" class={inputCls} placeholder="07xx xxx xxx" />
    </div>
    <div>
      <label class={labelCls} for="email">Email</label>
      <input id="email" name="email" type="email" class={inputCls} placeholder="email@exemplu.ro" />
    </div>
    <div>
      <label class={labelCls} for="localitate">Localitate / Judet</label>
      <input id="localitate" name="localitate" class={inputCls} placeholder="Ex: Otopeni, Ilfov" />
    </div>
    <div class="sm:col-span-2">
      <label class={labelCls} for="serviciu">Tip serviciu</label>
      <select id="serviciu" name="serviciu" class={inputCls}>
        <option value="">Alege serviciul...</option>
        {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
        <option value="Altele">Altele / nu sunt sigur</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class={labelCls} for="mesaj">Detalii</label>
      <textarea
        id="mesaj"
        name="mesaj"
        rows="4"
        class={inputCls}
        placeholder="Adancime estimata, ce stii despre teren, alte detalii..."></textarea>
    </div>
  </div>

  <label class="mt-4 flex items-start gap-2.5 text-sm text-muted">
    <input type="checkbox" name="gdpr" required class="mt-0.5 h-4 w-4 accent-[#1D4ED8]" />
    <span>
      Sunt de acord cu prelucrarea datelor conform
      <a href={withBase('politica-de-confidentialitate')} class="text-secondary underline underline-offset-2">
        politicii de confidentialitate</a>.
    </span>
  </label>

  <div class="mt-5">
    <Button type="submit" variant="cta" size="lg" icon="ph:paper-plane-tilt-fill" class="w-full sm:w-auto">
      Trimite cererea
    </Button>
    <p id="form-error" class="mt-3 hidden text-sm font-medium text-red-700" role="alert"></p>
    <p class="mt-3 text-sm text-muted">
      Mai rapid: suna direct la
      <a href={site.phoneHref} data-cta="formular" class="font-bold text-primary underline underline-offset-2">{site.phone}</a>.
    </p>
  </div>
</form>

<script>
  import { withBase } from '../lib/url';

  // La trimitere: valideaza, trimite cererea, apoi du userul pe /multumim
  // (acolo se declanseaza conversia Google Ads / GA4).
  //  - cu cheie Web3Forms (src/lib/tracking.ts) -> cererea ajunge pe email;
  //  - fara cheie -> se deschide WhatsApp cu mesajul precompletat catre firma.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    const val = (k: string) => String(data.get(k) ?? '').trim();
    const key = form.dataset.w3fKey;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;

    if (key) {
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            subject: `Cerere oferta foraj - ${val('localitate') || 'site'}`,
            from_name: form.dataset.site,
            nume: val('nume'),
            telefon: val('telefon'),
            email: val('email'),
            localitate: val('localitate'),
            serviciu: val('serviciu'),
            mesaj: val('mesaj'),
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = withBase('multumim');
      } catch {
        if (submitBtn) submitBtn.disabled = false;
        if (errorEl) {
          errorEl.textContent = 'Nu am putut trimite formularul. Te rugam sa ne suni sau sa ne scrii pe WhatsApp.';
          errorEl.classList.remove('hidden');
        }
      }
      return;
    }

    const lines = [
      'Buna ziua! Cerere oferta de pe site:',
      val('nume') && `Nume: ${val('nume')}`,
      `Telefon: ${val('telefon')}`,
      val('localitate') && `Localitate: ${val('localitate')}`,
      val('serviciu') && `Serviciu: ${val('serviciu')}`,
      val('mesaj') && `Detalii: ${val('mesaj')}`,
    ].filter(Boolean);
    window.open(`${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
    window.location.href = withBase('multumim');
  });
</script>
