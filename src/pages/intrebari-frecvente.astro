---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { withBase } from '../lib/url';

const groups = [
  {
    title: 'General',
    items: [
      { q: 'Ce zone acoperiți?', a: 'Lucrăm la nivel național. Spune-ne unde te afli și confirmăm disponibilitatea pentru localitatea ta.' },
      { q: 'În cât timp veniți?', a: 'De regulă ne programăm rapid; în zonele apropiate putem ajunge în câteva zile, în funcție de încărcare.' },
      { q: 'Lucrați și iarna?', a: 'Da, executăm foraje pe tot parcursul anului, cu adaptări acolo unde vremea o cere.' },
    ],
  },
  {
    title: 'Preț',
    items: [
      { q: 'Cât costă un foraj de puț?', a: 'Nu există un preț fix - depinde de adâncime, diametru, sol și materiale. Cel mai simplu suni sau ceri o ofertă, iar noi îți dăm un preț exact, gratuit.' },
      { q: 'De ce variază prețul?', a: 'Pentru că fiecare teren e diferit: adâncimea la care e apa, diametrul, tipul de sol și materialele influențează costul.' },
      { q: 'Ce include prețul?', a: 'Forajul, tubajul și filtrele, denisiparea și testul de debit. Îți spunem clar ce intră în ofertă, fără costuri ascunse.' },
      { q: 'Dați deviz gratuit?', a: 'Da, devizul este gratuit și fără obligații.' },
    ],
  },
  {
    title: 'Tehnic',
    items: [
      { q: 'La ce adâncime găsiți apa?', a: 'Depinde de zonă și de pânza freatică locală, în general între 10 și 80 m pentru gospodărie.' },
      { q: 'Ce diametru și tubaj folosiți?', a: 'Uzual 125-200 mm, cu tubaj din PVC alimentar sau inox și filtre potrivite stratului.' },
      { q: 'Cât durează un foraj?', a: 'Pentru adâncimi obișnuite, de regulă o zi. La adâncimi mari poate dura mai mult; îți spunem din start.' },
      { q: 'Pe ce tip de sol puteți fora?', a: 'Pe majoritatea tipurilor de teren, inclusiv medii dure, folosind tehnologia potrivită fiecărei situații.' },
    ],
  },
  {
    title: 'Legal și autorizații',
    items: [
      { q: 'Îmi trebuie autorizație?', a: 'Conform Legii Apelor 107/1996, peste anumite adâncimi sau debite este nevoie de aviz de la Apele Române. Te consiliem în funcție de cazul tău.' },
      { q: 'Cine se ocupă de acte?', a: 'Te consiliem și pregătim documentația necesară, ca tu să nu te complici cu actele.' },
    ],
  },
  {
    title: 'Garanție și întreținere',
    items: [
      { q: 'Ce garanție oferiți?', a: 'Garanție în scris, menționată în contract, în funcție de tipul lucrării.' },
      { q: 'Cât de des trebuie denisipat puțul?', a: 'Recomandăm o denisipare la 3-4 ani, sau mai devreme dacă scade debitul ori apa iese cu nisip.' },
      { q: 'Apa este potabilă?', a: 'Depinde de strat și zonă. Recomandăm o analiză de laborator; putem fora și la stratul cu apă de calitate mai bună.' },
    ],
  },
];

const allItems = groups.flatMap((g) => g.items);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Întrebări frecvente despre foraje puțuri"
  description="Răspunsuri la cele mai dese întrebări despre foraje puțuri apă: preț, adâncime, autorizații, garanție și întreținere."
  jsonLd={faqLd}
>
  <PageHero
    eyebrow="Întrebări frecvente"
    title="Răspunsuri la întrebările tale"
    subtitle="Am adunat cele mai dese întrebări despre foraje, prețuri, autorizații și garanție."
    breadcrumb={[{ label: 'Acasă', href: withBase('') }, { label: 'Întrebări frecvente' }]}
  />

  <section class="py-16 sm:py-20">
    <div class="wrap space-y-12">
      {
        groups.map((g) => (
          <div>
            <h2 class="mb-6 text-2xl">{g.title}</h2>
            <Faq items={g.items} />
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
