---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Politica de cookies" description="Politica privind utilizarea cookie-urilor pe acest site." noindex={true}>
  <PageHero
    title="Politica de cookies"
    breadcrumb={[{ label: 'Acasă', href: withBase('') }, { label: 'Politica de cookies' }]}
  />

  <section class="py-14 sm:py-16">
    <div class="wrap">
      <div class="rte mx-auto max-w-3xl">
        <h2>Ce sunt cookie-urile</h2>
        <p>
          Cookie-urile sunt fișiere mici stocate de browser, folosite pentru a face site-ul să
          funcționeze corect și pentru a îmbunătăți experienta de navigare.
        </p>

        <h2>Ce cookie-uri folosim</h2>
        <ul>
          <li><strong>Esențiale</strong> - necesare pentru funcționarea de bază a site-ului;</li>
          <li><strong>De performanță</strong> - ne ajută să înțelegem cum este folosit site-ul (dacă sunt activate);</li>
          <li><strong>De la terți</strong> - de exemplu hartă integrată.</li>
        </ul>

        <h2>Cum le poți controla</h2>
        <p>
          Poți gestiona sau șterge cookie-urile din setările browserului. Dezactivarea unora poate
          afecta funcționarea site-ului.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
