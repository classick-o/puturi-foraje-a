---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TrustBar from '../components/TrustBar.astro';
import IconTile from '../components/IconTile.astro';
import CollapsibleCards from '../components/CollapsibleCards.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { site, whyUs } from '../lib/site';
import { withBase } from '../lib/url';
import { photos, asset } from '../lib/media';

const values = whyUs.slice(0, 6);
const partners = ['Grundfos', 'Wilo', 'Pedrollo', 'DAB', 'Lowara'];
---

<BaseLayout
  title="Despre noi"
  description="Firmă de foraje puțuri apă cu peste 15 ani de experiență, echipă și utilaje proprii, garanție în scris și preț corect."
>
  <PageHero
    eyebrow="Despre noi"
    title="O echipă serioasă, cu utilaje proprii"
    subtitle="Peste 15 ani de experiență în foraje puțuri de apă. Lucrăm corect, cu materiale de calitate, garanție în scris și documentație inclusă."
    breadcrumb={[{ label: 'Acasă', href: withBase('') }, { label: 'Despre noi' }]}
  />

  <!-- Poveste -->
  <section class="py-16 sm:py-20">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">Foraje făcute ca la carte, de peste 15 ani</h2>
        <div class="mt-4 space-y-4 leading-relaxed text-muted">
          <p>
            Am pornit de la un singur utilaj și o promisiune simplă: lucrări de calitate, la un preț
            corect. Cu timpul am crescut, am investit în echipamente moderne și ne-am format o echipă
            de oameni cu experiență, dar promisiunea a rămas aceeași.
          </p>
          <p>
            Astăzi executăm foraje în toată țara, de la puțuri pentru gospodărie până la sonde pentru
            pompe de căldură, și ne ocupăm inclusiv de documentația necesara. Punem accent pe
            transparență: știi din start la ce să te aștepți, fără costuri ascunse.
          </p>
        </div>
        <div class="mt-8">
          <Button href={withBase('contact')} variant="primary" iconRight="ph:arrow-right-bold">Discută cu noi</Button>
        </div>
      </div>
      <div>
        <img
          src={asset(photos.instalatieGradina.src)}
          alt={photos.instalatieGradina.alt}
          width="640"
          height="800"
          loading="lazy"
          class="mx-auto aspect-[4/5] w-full max-w-md rounded-xl object-cover shadow-md"
        />
      </div>
    </div>
  </section>

  <!-- Cifre -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap">
      <h2 class="text-center text-3xl">Cifrele care ne reprezintă</h2>
      <div class="mt-10">
        <TrustBar />
      </div>
    </div>
  </section>

  <!-- Valori -->
  <section class="py-16 sm:py-20">
    <div class="wrap">
      <h2 class="text-3xl sm:text-4xl">Ce ne deosebește</h2>
      <CollapsibleCards label="Vezi toate valorile" class="mt-10">
        <div data-collapse-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            values.map((v) => (
              <div class="rounded-xl border border-border bg-surface p-6 shadow-sm">
                <div class="flex items-center gap-4">
                  <IconTile icon={v.icon} />
                  <h3 class="text-lg font-bold text-primary">{v.title}</h3>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-muted">{v.text}</p>
              </div>
            ))
          }
        </div>
      </CollapsibleCards>
    </div>
  </section>

  <!-- Garantii + Parteneri -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-2">
      <div class="rounded-xl border border-border bg-background p-8">
        <div class="flex items-center gap-4">
          <IconTile icon="ph:seal-check-duotone" size="lg" />
          <h2 class="text-2xl">Garanție în scris</h2>
        </div>
        <p class="mt-4 leading-relaxed text-muted">
          Oferim garanție în scris, menționată clar în contract, în funcție de tipul lucrării.
          Iar după finalizare rămânem alături de tine cu suport și mentenanță.
        </p>
      </div>
      <div class="rounded-xl border border-border bg-background p-8">
        <div class="flex items-center gap-4">
          <IconTile icon="ph:medal-duotone" size="lg" />
          <h2 class="text-2xl">Mărci de încredere</h2>
        </div>
        <p class="mt-4 leading-relaxed text-muted">
          Pentru sistemele de pompare lucrăm cu branduri recunoscute, pentru durabilitate și
          performanță în timp.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            partners.map((p) => (
              <span class="rounded-md border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-primary">
                {p}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
