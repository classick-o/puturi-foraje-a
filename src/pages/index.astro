---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustBar from '../components/TrustBar.astro';
import IconTile from '../components/IconTile.astro';
import Steps from '../components/Steps.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import WaterBackground from '../components/WaterBackground.astro';
import CollapsibleCards from '../components/CollapsibleCards.astro';
import VideoCard from '../components/VideoCard.astro';
import { site, whyUs, faqs, zones } from '../lib/site';
import { withBase } from '../lib/url';
import { videos, photos, asset, videoLd } from '../lib/media';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1)).slice(0, 3);

const heroPoints = ['Utilaj si echipa proprie', 'Deviz gratuit la telefon', 'Garantie in scris', 'Ne ocupam de acte'];
const heroPoster = withBase('media/put-arteziu-apa.webp');
const heroLoop = withBase('media/put-arteziu-apa-loop.mp4');

// Fiecare etapa, cu poza reala de pe santier
const workSteps = [
  { photo: photos.instalatieHidraulica, title: 'Forare cu utilaj propriu', text: 'Venim cu instalatia noastra, foram pana la stratul de apa potrivit si colectam namolul intr-un sant de decantare - curtea ramane curata.' },
  { photo: photos.tubFiltru, title: 'Tubaj PVC cu filtru cu fanta', text: 'Coloana din PVC pentru apa, cu filtru cu fanta in dreptul stratului acvifer. Asa apa intra limpede si putul nu se colmateaza.' },
  { photo: photos.jetApa, title: 'Denisipare si test de debit', text: 'Spalam putul pana iese apa curata si masuram debitul real inainte sa plecam. Stii exact cata apa ai.' },
  { photo: photos.santRacord, title: 'Pompa si racord la casa', text: 'Montam pompa submersibila sau hidroforul si tragem teava pana in casa. Predam lucrarea functionala, cu garantie.' },
];

const homeLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL(withBase(''), Astro.site).href,
    inLanguage: 'ro-RO',
  },
  ...videos.map((v) => videoLd(v, Astro.site)),
];
---

<BaseLayout
  title={`Foraje Puturi Apa cu Utilaj Propriu - Deviz Gratuit | ${site.name}`}
  description={`Foraje puturi de apa pentru casa, gradina si irigatii: forare, tubaj PVC, denisipare, pompa. Vezi filmari reale de pe santier. Suna ${site.phone} - pret pe loc.`}
  jsonLd={homeLd}
  preload={heroPoster}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-primary text-white">
    <div
      class="pointer-events-none absolute inset-0"
      style="background-image: radial-gradient(55% 60% at 85% 10%, rgba(10,111,191,.45) 0, transparent 60%), radial-gradient(45% 50% at 0% 100%, rgba(255,138,31,.12) 0, transparent 60%);"
    >
    </div>
    <div class="wrap relative grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.15fr_.85fr] lg:py-20">
      <div>
        <span class="eyebrow !text-accent">Foraje puturi apa &middot; toata Romania</span>
        <h1 class="mt-4 text-[2.15rem] leading-[1.05] !text-white sm:text-5xl lg:text-[3.4rem]">
          Foraje puturi de apa cu <span class="text-accent">utilaj propriu</span>. Apa la tine in curte.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/75">
          Forare, tubaj PVC cu filtru, denisipare si pompa montata - totul facut de echipa noastra,
          de regula intr-o singura zi. Afli pretul exact printr-un singur telefon.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={site.phoneHref}
            data-cta="hero"
            class="group inline-flex items-center justify-center gap-3 rounded-md bg-accent px-6 py-4 text-primary shadow-lg transition-all hover:-translate-y-px hover:bg-accent-hover"
          >
            <Icon name="ph:phone-call-fill" class="text-3xl" />
            <span class="text-left leading-tight">
              <span class="block text-xs font-semibold uppercase tracking-wide opacity-80">Suna acum, raspundem imediat</span>
              <span class="block font-display text-2xl font-extrabold tabular-nums" style="font-stretch: 90%">{site.phone}</span>
            </span>
          </a>
          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener"
            data-cta="hero"
            class="inline-flex items-center justify-center gap-2 rounded-md border-[1.5px] border-white/25 px-5 py-4 font-semibold text-white transition-colors hover:bg-white/10"
          >
            <Icon name="ph:whatsapp-logo-fill" class="text-2xl text-[#25D366]" />
            Trimite poze pe WhatsApp
          </a>
        </div>
        <p class="mt-3 text-sm text-white/60">
          {site.schedule} &middot;
          <a href={withBase('contact')} class="underline underline-offset-2 hover:text-white">sau cere oferta scrisa</a>
        </p>

        <ul class="mt-8 grid max-w-md grid-cols-2 gap-3 text-sm">
          {
            heroPoints.map((p) => (
              <li class="flex items-center gap-2 text-white/85">
                <Icon name="ph:check-circle-fill" class="shrink-0 text-lg text-accent" />
                {p}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative mx-auto w-full max-w-[300px] sm:max-w-[340px]">
        <div class="relative overflow-hidden rounded-2xl border-4 border-white/10 bg-black shadow-2xl">
          <video
            class="aspect-[9/16] w-full object-cover"
            src={heroLoop}
            poster={heroPoster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Filmare reala: apa tasneste din putul forat de echipa noastra"
          ></video>
          <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-md bg-primary/85 px-2.5 py-1 text-xs font-semibold">
            <span class="h-2 w-2 rounded-full bg-red-500"></span>
            Filmare reala de pe santier
          </span>
        </div>
        <div class="absolute -left-6 bottom-8 hidden rounded-xl border border-border bg-surface p-3.5 text-primary shadow-lg sm:block">
          <div class="flex items-center gap-3">
            <IconTile icon="ph:drop-duotone" />
            <div>
              <div class="text-sm font-bold">Apa curata, cu presiune</div>
              <div class="text-xs text-muted">put forat de echipa noastra</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hazard-stripe h-2" aria-hidden="true"></div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <div class="wrap relative z-10 pt-8 pb-2">
    <TrustBar />
  </div>

  <!-- ============ VIDEO SANTIER ============ -->
  <section class="py-16 sm:py-20" id="filmari">
    <div class="wrap">
      <SectionHeader
        eyebrow="Lucrari reale"
        title="Vezi cum lucram - filmat de echipa noastra"
        subtitle="Fara poze de stoc. Acestea sunt filmari de pe santierele noastre: utilajul, materialele si rezultatul final."
      />
      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
        {videos.map((v) => <VideoCard video={v} />)}
      </div>
      <div class="mt-10 flex flex-col items-center gap-3 text-center">
        <p class="text-lg font-semibold text-primary">Vrei acelasi rezultat la tine in curte?</p>
        <Button href={site.phoneHref} variant="cta" size="lg" icon="ph:phone-call-fill" data-cta="filmari">
          Suna: {site.phone}
        </Button>
      </div>
    </div>
  </section>

  <!-- ============ SERVICII ============ -->
  <section class="relative overflow-hidden py-16 sm:py-20">
    <WaterBackground />
    <div class="wrap relative z-10">
      <SectionHeader
        eyebrow="Servicii"
        title="Tot ce tine de foraje, intr-un singur loc"
        subtitle="De la forajul putului pana la punerea in functiune si documentatie - ne ocupam noi de tot."
      />
      <CollapsibleCards label="Vezi toate serviciile" class="mt-12">
        <div data-collapse-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((s) => (
              <ServiceCard slug={s.id} title={s.data.title} icon={s.data.icon} excerpt={s.data.excerpt} />
            ))
          }
        </div>
      </CollapsibleCards>
    </div>
  </section>

  <!-- ============ DE CE NOI ============ -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap">
      <SectionHeader
        eyebrow="De ce sa ne alegi"
        title="Calitate de incredere, la un pret corect"
        subtitle="Nu suntem cei mai ieftini, ci cel mai bun raport calitate-pret. Iata ce primesti:"
      />
      <CollapsibleCards label="Vezi toate motivele" class="mt-12">
        <div data-collapse-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            whyUs.map((w) => (
              <div class="rounded-xl border border-border bg-background p-6">
                <div class="flex items-center gap-4">
                  <IconTile icon={w.icon} />
                  <h3 class="text-lg font-bold text-primary">{w.title}</h3>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-muted">{w.text}</p>
              </div>
            ))
          }
        </div>
      </CollapsibleCards>
    </div>
  </section>

  <!-- ============ CUM LUCRAM ============ -->
  <section class="py-16 sm:py-20">
    <div class="wrap">
      <SectionHeader eyebrow="Cum lucram" title="De la primul telefon, pana la apa curata" />
      <div class="mt-12">
        <Steps />
      </div>
    </div>
  </section>

  <!-- ============ DESPRE PE SCURT ============ -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2">
      <div class="relative order-2 lg:order-1">
        <div class="grid grid-cols-2 gap-4">
          <img
            src={asset(photos.instalatieCamp.src)}
            alt={photos.instalatieCamp.alt}
            width="640"
            height="1138"
            loading="lazy"
            class="aspect-[3/4] w-full rounded-xl object-cover shadow-md"
          />
          <img
            src={asset(photos.instalatieGradina.src)}
            alt={photos.instalatieGradina.alt}
            width="640"
            height="1138"
            loading="lazy"
            class="mt-10 aspect-[3/4] w-full rounded-xl object-cover shadow-md"
          />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="text-3xl sm:text-4xl">O echipa serioasa, cu utilaje proprii</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Suntem o firma cu peste 15 ani de experienta in foraje puturi de apa, cu echipa si
          utilaje proprii. Lucram corect, cu materiale de calitate si garantie in scris, si ne
          ocupam inclusiv de documentatia necesara.
        </p>
        <ul class="mt-6 space-y-3">
          {
            ['Utilaje moderne, fara subcontractari', 'Materiale de calitate la tubaj si filtre', 'Suport si dupa finalizarea lucrarii'].map((t) => (
              <li class="flex items-start gap-2.5 text-sm text-ink/90">
                <Icon name="ph:check-circle-duotone" class="mt-0.5 text-lg text-secondary" />
                {t}
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <Button href={withBase('despre-noi')} variant="outline" iconRight="ph:arrow-right-bold">
            Afla mai multe despre noi
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CE PRIMESTI (poze reale) ============ -->
  <section class="py-16 sm:py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeader
          align="left"
          eyebrow="Ce primesti"
          title="Un put facut complet, nu doar o gaura in pamant"
          subtitle="Fiecare etapa, asa cum arata la noi pe santier."
        />
        <Button href={withBase('portofoliu')} variant="ghost" iconRight="ph:arrow-right-bold" class="hidden sm:inline-flex">
          Toate pozele si filmarile
        </Button>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          workSteps.map((w, i) => (
            <li class="overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
              <div class="relative aspect-[4/5] overflow-hidden">
                <img src={asset(w.photo.src)} alt={w.photo.alt} width="480" height="600" loading="lazy" class="h-full w-full object-cover" />
                <span class="absolute left-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-md bg-accent font-display text-lg font-extrabold text-primary">
                  {i + 1}
                </span>
              </div>
              <div class="p-5">
                <h3 class="text-lg">{w.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ ZONE ============ -->
  <section class="bg-primary py-16 text-white sm:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <h2 class="text-3xl !text-white sm:text-4xl">Lucram in toata tara</h2>
        <p class="mt-4 leading-relaxed text-white/75">
          Ne deplasam la nivel national. Iata cateva dintre judetele in care am executat lucrari -
          spune-ne unde te afli si venim si la tine.
        </p>
        <div class="mt-8">
          <Button href={withBase('zone-acoperite')} variant="cta" iconRight="ph:arrow-right-bold">
            Vezi zonele deservite
          </Button>
        </div>
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          zones.slice(0, 12).map((z) => (
            <li class="flex items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-white/85">
              <Icon name="ph:map-pin-duotone" class="text-accent" />
              {z}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ TESTIMONIALE ============ -->
  <section class="py-16 sm:py-20">
    <div class="wrap">
      <SectionHeader eyebrow="Pareri clienti" title="Ce spun oamenii despre noi" />
      <div class="mt-12">
        <Testimonials limit={3} />
      </div>
    </div>
  </section>

  <!-- ============ PRET TRANSPARENT ============ -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap grid items-center gap-10 rounded-xl border border-border bg-background p-8 sm:p-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">Afla pretul printr-un telefon</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Fiecare lucrare e diferita, asa ca iti dam un pret exact, gratuit, dupa o scurta discutie
          despre terenul tau. Fara costuri ascunse - iti spunem din start la ce sa te astepti.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={site.phoneHref} variant="cta" size="lg" icon="ph:phone-call-fill" data-cta="pret">Suna acum: {site.phone}</Button>
          <Button href={withBase('contact')} variant="outline">Cere oferta</Button>
        </div>
      </div>
      <ul class="space-y-3">
        {
          ['Deviz personalizat, gratuit', 'Tubaj si filtre de calitate', 'Fara costuri ascunse', 'Garantie in scris'].map((t) => (
            <li class="flex items-center gap-3 rounded-md border border-border bg-surface px-4 py-3 text-sm font-medium text-primary">
              <Icon name="ph:check-circle-fill" class="text-lg text-success" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="py-16 sm:py-20">
    <div class="wrap">
      <SectionHeader eyebrow="Intrebari frecvente" title="Raspunsuri la cele mai dese intrebari" />
      <div class="mt-12">
        <Faq items={faqs.slice(0, 5)} />
      </div>
      <p class="mt-6 text-center text-sm text-muted">
        Mai ai intrebari?
        <a href={withBase('intrebari-frecvente')} class="font-semibold text-secondary underline underline-offset-2">
          Vezi toate intrebarile frecvente
        </a>
      </p>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeader align="left" eyebrow="Blog" title="Articole utile despre foraje" />
        <Button href={withBase('blog')} variant="ghost" iconRight="ph:arrow-right-bold" class="hidden sm:inline-flex">
          Vezi blogul
        </Button>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          posts.map((post) => (
            <a
              href={withBase(`blog/${post.id}`)}
              class="group flex flex-col overflow-hidden rounded-xl border border-border bg-background shadow-sm transition-all hover:-translate-y-1 hover:shadow-md"
            >
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={post.data.image && asset(post.data.image)}
                  alt={post.data.title}
                  width="800"
                  height="450"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <span class="text-xs font-semibold uppercase tracking-wide text-secondary">{post.data.category}</span>
                <h3 class="mt-2 text-base font-bold leading-snug text-primary">{post.data.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{post.data.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
