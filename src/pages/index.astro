---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Strata from '../components/Strata.astro';
import VideoCard from '../components/VideoCard.astro';
import { site, faqs, zones, whyUs } from '../lib/site';
import { withBase } from '../lib/url';
import { videos, photos, asset, videoLd } from '../lib/media';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1)).slice(0, 3);

const heroPoster = withBase('media/put-arteziu-apa.webp');
const heroLoop = withBase('media/put-arteziu-apa-loop.mp4');

// Ziua forajului, in ordinea reala a lucrarilor - fiecare cu poza de pe santier
const workSteps = [
  {
    photo: photos.instalatieHidraulica,
    title: 'Forăm cu utilajul nostru',
    text: 'Montăm instalația lângă locul ales și forăm până la stratul de apă. Nămolul merge într-un șanț de decantare, nu prin toată curtea.',
  },
  {
    photo: photos.tubFiltru,
    title: 'Tubăm cu PVC și filtru cu fantă',
    text: 'Coloana albastră din PVC pentru apă, cu filtru în dreptul stratului bun. Așa intră apa, iar nisipul rămâne afară.',
  },
  {
    photo: photos.jetApa,
    title: 'Spălăm puțul și măsurăm debitul',
    text: 'Pompăm până iese apa limpede, apoi măsurăm câtă apă dă puțul. Afli cifra reală înainte să plecăm.',
  },
  {
    photo: photos.santRacord,
    title: 'Montăm pompa și tragem apa în casă',
    text: 'Pompă submersibilă sau hidrofor, țeava până la casă și pornirea. Pleci cu apa la robinet și garanția în scris.',
  },
];

const homeLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL(withBase(''), Astro.site).href,
    inLanguage: 'ro-RO',
  },
  ...videos.map((v) => videoLd(v, Astro.site)),
];
---

<BaseLayout
  title={`Foraje Puțuri Apă cu Utilaj Propriu - Preț la Telefon | ${site.name}`}
  description={`Foraje puțuri de apă pentru casă, grădină și irigații: forare, tubaj PVC cu filtru, denisipare, pompă. Vezi filmări reale de pe șantier. Sună la ${site.phone}.`}
  jsonLd={homeLd}
  preload={heroPoster}
>
  <!-- ============ HERO: suprafata ============ -->
  <section class="soil-texture relative overflow-hidden text-[#F2F4EF]">
    <div class="wrap grid gap-10 pb-12 pt-9 sm:pt-14 lg:grid-cols-[1.25fr_.75fr] lg:items-end lg:gap-14 lg:pb-16 lg:pt-20">
      <div>
        <h1 class="drill-in text-[3.9rem] !leading-[0.86] !text-[#F2F4EF] min-[400px]:text-[4.4rem] sm:text-[6rem] lg:text-[7.4rem]">
          Forăm până dăm de apă.
        </h1>
        <p class="mt-6 max-w-[34rem] text-[1.15rem] leading-relaxed text-[#F2F4EF]/80">
          Venim cu utilajul nostru, forăm, tubăm cu PVC și filtru, spălăm puțul până iese apa
          limpede și montăm pompa. De regulă, totul într-o singură zi.
        </p>

        <div class="mt-8 max-w-[30rem]">
          <a
            href={site.phoneHref}
            data-cta="hero"
            class="flex items-center gap-4 rounded-md bg-accent px-5 py-4 text-primary shadow-[0_5px_0_#b38c00] transition-colors hover:bg-accent-hover active:translate-y-[2px] active:shadow-[0_3px_0_#b38c00]"
          >
            <Icon name="ph:phone-fill" class="shrink-0 text-[2.4rem]" />
            <span class="leading-none">
              <span class="block font-display text-[2.6rem] font-black tabular-nums sm:text-[3rem]">{site.phone}</span>
              <span class="mt-1.5 block font-bold">Îți spunem prețul la telefon, gratuit</span>
            </span>
          </a>
          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener"
            data-cta="hero"
            class="mt-4 inline-flex items-center gap-2 font-bold text-[#F2F4EF] underline decoration-[#25D366] decoration-2 underline-offset-4 hover:decoration-[#F2F4EF]"
          >
            <Icon name="ph:whatsapp-logo-fill" class="text-2xl text-[#25D366]" />
            Trimite-ne o poză cu terenul pe WhatsApp
          </a>
        </div>

        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[0.98rem] text-[#F2F4EF]/85">
          <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 bg-accent"></span>Utilaj și echipă proprie</li>
          <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 bg-accent"></span>Garanție în scris</li>
          <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 bg-accent"></span>Ne ocupăm de acte</li>
        </ul>
      </div>

      <figure class="mx-auto w-full max-w-[330px] lg:mx-0 lg:justify-self-end">
        <div class="relative flex gap-2.5">
          <!-- rigla de adancime -->
          <div class="ruler w-3 shrink-0" aria-hidden="true"></div>
          <div class="relative flex-1 overflow-hidden rounded-[14px] border-[3px] border-[#F2F4EF]/15 bg-black">
            <video
              class="aspect-[9/16] w-full object-cover"
              src={heroLoop}
              poster={heroPoster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Filmare reală: apa iese din puțul forat de echipa noastră"
            ></video>
          </div>
        </div>
        <figcaption class="mt-3 pl-[1.4rem] text-sm text-[#F2F4EF]/65">
          Filmat la un client, 1 septembrie 2026. Apa la suprafață, imediat după foraj.
        </figcaption>
      </figure>
    </div>
  </section>

  <Strata layer="soil" label="sol vegetal, 0–1 m" />

  <!-- ============ FILMARI ============ -->
  <section class="py-16 sm:py-24" id="filmari">
    <div class="wrap">
      <div class="grid gap-4 lg:grid-cols-[1fr_1fr] lg:items-end">
        <h2 class="text-[3rem] sm:text-[4.2rem]">Filmat la noi pe șantier</h2>
        <p class="max-w-md text-lg text-muted lg:justify-self-end">
          Fără poze de catalog. Așa arată un foraj făcut de echipa noastră, de la utilaj până la apă.
        </p>
      </div>
    </div>
    <div
      class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:none] sm:px-8 lg:mx-auto lg:grid lg:max-w-[1160px] lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:px-8 [&::-webkit-scrollbar]:hidden"
    >
      {videos.map((v) => <VideoCard video={v} class="w-[68vw] max-w-[300px] shrink-0 snap-start lg:w-auto lg:max-w-none" />)}
    </div>
    <p class="wrap mt-2 text-sm text-muted lg:hidden">Glisează pentru celelalte filmări.</p>
  </section>

  <Strata layer="loess" label="loess, 1–8 m" />

  <!-- ============ ZIUA FORAJULUI ============ -->
  <section class="bg-surface py-16 sm:py-24">
    <div class="wrap">
      <h2 class="max-w-3xl text-[3rem] sm:text-[4.2rem]">Ce se întâmplă în ziua forajului</h2>
      <ol class="relative mt-12 sm:mt-16">
        <!-- tubul -->
        <span class="absolute bottom-6 left-[13px] top-2 w-[6px] bg-secondary sm:left-[21px]" aria-hidden="true"></span>
        {
          workSteps.map((w, i) => (
            <li class="relative grid grid-cols-[32px_1fr] gap-x-4 pb-12 last:pb-0 sm:grid-cols-[48px_minmax(0,280px)_1fr] sm:gap-x-8">
              <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-sm bg-primary font-display text-xl font-black text-accent sm:h-12 sm:w-12 sm:text-3xl">
                {i + 1}
              </span>
              <img
                src={asset(w.photo.src)}
                alt={w.photo.alt}
                width="480"
                height="360"
                loading="lazy"
                class="col-start-2 aspect-[4/3] w-full rounded-lg object-cover sm:row-span-2"
              />
              <div class="col-start-2 mt-4 sm:col-start-3 sm:row-start-1 sm:mt-0">
                <h3 class="text-[1.9rem] sm:text-[2.4rem]">{w.title}</h3>
                <p class="mt-2 max-w-[36rem] text-[1.05rem] leading-relaxed text-muted">{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Strata layer="sand" label="nisip, 8–20 m" />

  <!-- ============ SERVICII ============ -->
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <h2 class="text-[3rem] sm:text-[4.2rem]">Ce facem</h2>
      <ul class="mt-10 grid gap-x-12 sm:grid-cols-2">
        {
          services.map((s) => (
            <li class="border-t-2 border-primary">
              <a href={withBase(`servicii/${s.id}`)} class="group flex gap-4 py-5">
                <Icon name={s.data.icon} class="mt-1 shrink-0 text-[1.7rem] text-secondary" />
                <span>
                  <span class="block font-display text-[1.75rem] font-extrabold leading-tight text-primary decoration-secondary decoration-2 underline-offset-4 group-hover:underline">
                    {s.data.title}
                  </span>
                  <span class="mt-1 block text-muted">{s.data.excerpt}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Strata layer="gravel" label="pietriș, 20–35 m" />

  <!-- ============ PRET ============ -->
  <section class="bg-surface py-16 sm:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div>
        <h2 class="text-[3rem] sm:text-[4.2rem]">Cât costă un puț?</h2>
        <div class="mt-6 max-w-[36rem] space-y-4 text-[1.1rem] leading-relaxed">
          <p>
            Depinde de adâncime, de diametru și de ce găsim în pământ. De aceea nu punem pe site un
            preț pe metru care se schimbă când ajungem la tine.
          </p>
          <p>
            Ne suni, ne spui localitatea și pentru ce îți trebuie apa, iar noi îți spunem prețul
            complet, din prima. Nu plătești nimic pentru ofertă.
          </p>
        </div>
        <a
          href={site.phoneHref}
          data-cta="pret"
          class="mt-8 inline-flex items-center gap-3 rounded-md bg-accent px-6 py-3.5 font-display text-[2rem] font-black tabular-nums text-primary shadow-[0_4px_0_#b38c00] hover:bg-accent-hover"
        >
          <Icon name="ph:phone-fill" class="text-[1.6rem]" />
          {site.phone}
        </a>
      </div>
      <div class="self-start rounded-lg border-2 border-primary bg-background p-6 sm:p-8">
        <h3 class="text-[1.9rem]">Ce intră în preț</h3>
        <ul class="mt-5 space-y-3.5 text-[1.05rem]">
          {
            [
              'Forajul, la adâncimea stabilită împreună',
              'Coloana de tubaj PVC și filtrul cu fantă',
              'Denisiparea, până iese apa limpede',
              'Testul de debit, înainte să plecăm',
              'Garanția în scris, trecută în contract',
            ].map((t) => (
              <li class="flex gap-3">
                <Icon name="ph:check-bold" class="mt-1 shrink-0 text-xl text-secondary" />
                {t}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 border-t border-border pt-4 text-muted">
          Pompa, hidroforul și actele pentru Apele Române le facem la cerere.
        </p>
      </div>
    </div>
  </section>

  <Strata layer="clay" label="argilă, 35–50 m" />

  <!-- ============ ZONE + PARERI ============ -->
  <section class="py-16 sm:py-24">
    <div class="wrap grid gap-14 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <h2 class="text-[3rem] sm:text-[4.2rem]">Unde lucrăm</h2>
        <p class="mt-6 text-[1.1rem] leading-relaxed">
          Ne deplasăm în toată țara. Mergem, printre altele, în {zones.join(', ')}.
        </p>
        <p class="mt-4 text-[1.1rem] leading-relaxed text-muted">
          Nu-ți vezi județul? Sună-ne, cel mai probabil ajungem și la tine.
        </p>
        <a href={withBase('zone-acoperite')} class="mt-6 inline-block font-bold text-secondary underline decoration-2 underline-offset-4">
          Vezi zonele în care lucrăm
        </a>
      </div>
      <div>
        <h2 class="text-[3rem] sm:text-[4.2rem]">Cum lucrăm</h2>
        <dl class="mt-8 space-y-6">
          {
            whyUs.map((w) => (
              <div class="border-l-[6px] border-loess pl-5">
                <dt class="font-display text-[1.6rem] font-extrabold leading-tight text-primary">{w.title}</dt>
                <dd class="mt-1 text-[1.05rem] leading-relaxed text-muted">{w.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ INTREBARI ============ -->
  <section class="bg-surface py-16 sm:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <h2 class="text-[3rem] sm:text-[4.2rem]">Întrebări pe care le primim des</h2>
        <h3 class="mt-10 text-[1.6rem]">Ghiduri scrise de noi</h3>
        <ul class="mt-3 space-y-2.5">
          {
            posts.map((p) => (
              <li>
                <a href={withBase(`blog/${p.id}`)} class="font-bold text-secondary underline decoration-2 underline-offset-4 hover:text-primary">
                  {p.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Ai ajuns la apă."
    subtitle="Acum hai să ajungem și la tine. Sună-ne și afli prețul în câteva minute."
  />
</BaseLayout>

<style>
  .ruler {
    background-image:
      repeating-linear-gradient(to bottom, rgba(242, 244, 239, 0.55) 0 2px, transparent 2px 40px),
      repeating-linear-gradient(to bottom, rgba(242, 244, 239, 0.25) 0 1px, transparent 1px 8px);
    background-size: 100% 100%, 55% 100%;
    background-repeat: no-repeat, no-repeat;
  }
  /* Singurul moment animat: titlul "se foreaza" de sus in jos la incarcare */
  .drill-in {
    animation: drill 0.9s cubic-bezier(0.6, 0, 0.2, 1) both;
  }
  @keyframes drill {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
