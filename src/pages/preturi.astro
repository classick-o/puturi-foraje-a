---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const factors = [
  { icon: 'ph:ruler-duotone', label: 'Adancimea putului' },
  { icon: 'ph:circle-dashed-duotone', label: 'Diametrul ales' },
  { icon: 'ph:mountains-duotone', label: 'Tipul de sol si roca' },
  { icon: 'ph:stack-duotone', label: 'Materialele de tubaj' },
  { icon: 'ph:map-pin-duotone', label: 'Zona si accesul' },
  { icon: 'ph:calendar-dots-duotone', label: 'Sezonul' },
];
const included = [
  'Forajul propriu-zis',
  'Tubaj PVC si filtre',
  'Denisiparea putului',
  'Test de debit la final',
];
---

<BaseLayout
  title="Preturi foraje puturi apa"
  description="Cat costa un foraj de put? Pretul se stabileste personalizat, in functie de terenul tau. Suna-ne pentru o oferta exacta, gratuita."
>
  <PageHero
    title="Cat costa un foraj de put?"
    subtitle="Nu afisam un pret fix, pentru ca fiecare lucrare e diferita. Cel mai corect afli printr-un telefon: iti dam un pret exact, gratuit."
    breadcrumb={[{ label: 'Acasa', href: withBase('') }, { label: 'Preturi' }]}
  />

  <!-- CTA telefon principal -->
  <section class="py-14 sm:py-16">
    <div class="wrap">
      <div class="flex flex-col items-center gap-6 rounded-xl border border-secondary/20 bg-secondary-soft p-8 text-center sm:p-12">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-[10px] bg-primary text-3xl text-accent">
          <Icon name="ph:phone-call-duotone" />
        </span>
        <div>
          <h2 class="text-2xl sm:text-3xl">Afla pretul exact printr-un telefon</h2>
          <p class="mx-auto mt-3 max-w-xl text-muted">
            Spune-ne ce ai nevoie si unde te afli, iar noi iti dam pe loc o estimare corecta.
            Consultanta si devizul sunt gratuite, fara obligatii.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href={site.phoneHref} variant="cta" size="lg" icon="ph:phone-call-fill">
            Suna acum: {site.phone}
          </Button>
          <Button href={withBase('contact')} variant="outline" size="lg">Cere oferta online</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- De ce difera pretul -->
  <section class="pb-16 sm:pb-20">
    <div class="wrap">
      <h2 class="text-3xl sm:text-4xl">De ce difera pretul</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Pretul unui foraj se calculeaza in functie de conditiile concrete ale terenului tau. Iata ce
        conteaza cel mai mult:
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          factors.map((f) => (
            <div class="flex items-center gap-3 rounded-xl border border-border bg-surface px-5 py-4 shadow-sm">
              <Icon name={f.icon} class="text-2xl text-secondary" />
              <span class="font-medium text-primary">{f.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ce include oferta -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">Ce include oferta</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Vrem sa stii exact pe ce dai banii. In oferta pe care ti-o dam includem tot ce e necesar ca
          putul sa functioneze, fara surprize pe parcurs.
        </p>
        <ul class="mt-6 space-y-3">
          {
            included.map((t) => (
              <li class="flex items-center gap-3 text-sm font-medium text-primary">
                <Icon name="ph:check-circle-fill" class="text-lg text-success" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-background p-8 text-center">
        <h3 class="text-2xl text-primary">Vrei un pret pentru situatia ta?</h3>
        <p class="mx-auto mt-3 max-w-md text-muted">
          Un telefon scurt si iti spunem la ce sa te astepti. Fara obligatii.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href={site.phoneHref} variant="cta" icon="ph:phone-call-fill">Suna acum</Button>
          <Button href={withBase('contact')} variant="outline">Cere oferta</Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Nu te complici cu preturi fixe. Suna si afli pe loc."
    subtitle="Consultanta si devizul sunt gratuite, fara obligatii."
  />
</BaseLayout>
