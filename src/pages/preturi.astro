---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const factors = [
  { icon: 'ph:ruler-duotone', label: 'Adâncimea puțului' },
  { icon: 'ph:circle-dashed-duotone', label: 'Diametrul ales' },
  { icon: 'ph:mountains-duotone', label: 'Tipul de sol și rocă' },
  { icon: 'ph:stack-duotone', label: 'Materialele de tubaj' },
  { icon: 'ph:map-pin-duotone', label: 'Zona și accesul' },
  { icon: 'ph:calendar-dots-duotone', label: 'Sezonul' },
];
const included = [
  'Forajul propriu-zis',
  'Tubaj PVC și filtre',
  'Denisiparea puțului',
  'Test de debit la final',
];
---

<BaseLayout
  title="Prețuri foraje puțuri apă"
  description="Cât costă un foraj de puț? Prețul se stabilește personalizat, în funcție de terenul tău. Sună-ne pentru o ofertă exactă, gratuită."
>
  <PageHero
    title="Cât costă un foraj de puț?"
    subtitle="Nu afișăm un preț fix, pentru că fiecare lucrare e diferită. Cel mai corect afli printr-un telefon: îți dăm un preț exact, gratuit."
    breadcrumb={[{ label: 'Acasă', href: withBase('') }, { label: 'Prețuri' }]}
  />

  <!-- CTA telefon principal -->
  <section class="py-14 sm:py-16">
    <div class="wrap">
      <div class="flex flex-col items-center gap-6 rounded-xl border border-secondary/20 bg-secondary-soft p-8 text-center sm:p-12">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-[10px] bg-primary text-3xl text-accent">
          <Icon name="ph:phone-call-duotone" />
        </span>
        <div>
          <h2 class="text-2xl sm:text-3xl">Află prețul exact printr-un telefon</h2>
          <p class="mx-auto mt-3 max-w-xl text-muted">
            Spune-ne ce ai nevoie și unde te afli, iar noi îți dăm pe loc o estimare corectă.
            Consultanța și devizul sunt gratuite, fără obligații.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href={site.phoneHref} variant="cta" size="lg" icon="ph:phone-call-fill">
            Sună acum: {site.phone}
          </Button>
          <Button href={withBase('contact')} variant="outline" size="lg">Cere ofertă online</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- De ce difera pretul -->
  <section class="pb-16 sm:pb-20">
    <div class="wrap">
      <h2 class="text-3xl sm:text-4xl">De ce diferă prețul</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Prețul unui foraj se calculează în funcție de condițiile concrete ale terenului tău. Iată ce
        contează cel mai mult:
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          factors.map((f) => (
            <div class="flex items-center gap-3 rounded-xl border border-border bg-surface px-5 py-4 shadow-sm">
              <Icon name={f.icon} class="text-2xl text-secondary" />
              <span class="font-medium text-primary">{f.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ce include oferta -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="wrap grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">Ce include oferta</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Vrem să știi exact pe ce dai banii. În oferta pe care ți-o dăm includem tot ce e necesar ca
          puțul să funcționeze, fără surprize pe parcurs.
        </p>
        <ul class="mt-6 space-y-3">
          {
            included.map((t) => (
              <li class="flex items-center gap-3 text-sm font-medium text-primary">
                <Icon name="ph:check-circle-fill" class="text-lg text-success" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-background p-8 text-center">
        <h3 class="text-2xl text-primary">Vrei un preț pentru situația ta?</h3>
        <p class="mx-auto mt-3 max-w-md text-muted">
          Un telefon scurt și îți spunem la ce să te aștepți. Fără obligații.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href={site.phoneHref} variant="cta" icon="ph:phone-call-fill">Sună acum</Button>
          <Button href={withBase('contact')} variant="outline">Cere ofertă</Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Nu te complici cu prețuri fixe. Sună și afli pe loc."
    subtitle="Consultanța și devizul sunt gratuite, fără obligații."
  />
</BaseLayout>
