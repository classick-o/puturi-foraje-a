---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import VideoCard from '../components/VideoCard.astro';
import Button from '../components/Button.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';
import { videos, photos, asset, videoLd } from '../lib/media';

const gallery = Object.values(photos);
const jsonLd = videos.map((v) => videoLd(v, Astro.site));
---

<BaseLayout
  title="Lucrări Reale - Poze și Filmări de pe Șantier"
  description="Poze și filmări reale cu puțurile forate de echipa noastră: utilaj de foraj propriu, tubaj PVC cu filtru, denisipare și apă la suprafață."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Portofoliu"
    title="Lucrări reale, filmate pe șantier"
    subtitle="Nu folosim poze de stoc. Tot ce vezi aici e filmat de echipa noastră, la clienți: utilajul, materialele și rezultatul."
    breadcrumb={[{ label: 'Acasă', href: withBase('') }, { label: 'Portofoliu' }]}
  />

  <section class="py-16 sm:py-20">
    <div class="wrap">
      <h2 class="text-2xl sm:text-3xl">Filmări de pe șantier</h2>
      <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
        {videos.map((v) => <VideoCard video={v} />)}
      </div>

      <h2 class="mt-16 text-2xl sm:text-3xl">Poze din lucrări</h2>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:gap-6">
        {
          gallery.map((p) => (
            <figure class="overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
              <img src={asset(p.src)} alt={p.alt} width="480" height="640" loading="lazy" class="aspect-[3/4] w-full object-cover" />
              <figcaption class="px-4 py-3 text-sm font-semibold text-primary">{p.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-12 flex flex-col items-center gap-4 rounded-xl border border-secondary/20 bg-secondary-soft p-8 text-center">
        <p class="max-w-xl text-lg text-primary">
          Ai un teren și vrei să știi dacă găsim apă? Trimite-ne pe WhatsApp o poză cu locul și localitatea.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href={site.phoneHref} variant="cta" size="lg" icon="ph:phone-call-fill" data-cta="portofoliu">Sună: {site.phone}</Button>
          <Button href={site.whatsapp} variant="outline" size="lg" icon="ph:whatsapp-logo-fill" target="_blank" rel="noopener" data-cta="portofoliu">WhatsApp</Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Vrei să fii următorul proiect reușit?" />
</BaseLayout>
