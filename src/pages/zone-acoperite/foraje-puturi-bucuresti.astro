---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CollapsibleCards from '../../components/CollapsibleCards.astro';
import TrustBar from '../../components/TrustBar.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const localFacts = [
  { icon: 'ph:ruler-duotone', title: 'Adâncimi uzuale', text: 'În București și Ilfov, apa de calitate se găsește frecvent între 40 și 90 m, în funcție de zonă.' },
  { icon: 'ph:mountains-duotone', title: 'Tipul terenului', text: 'Straturi alternante de argilă, nisip și pietriș - adaptăm tehnologia de foraj la fiecare locație.' },
  { icon: 'ph:lightning-duotone', title: 'Deplasare rapidă', text: 'Fiind aproape, ajungem repede la tine pentru evaluare și execuție.' },
];
---

<BaseLayout
  title="Foraje puțuri apă București și Ilfov | Preț corect"
  description="Foraje puțuri de apă în București și Ilfov: execuție, denisipări și pompe de căldură. Adâncimi uzuale, deplasare rapidă, garanție în scris."
>
  <PageHero
    eyebrow="Zona: București și Ilfov"
    title="Foraje puțuri apă în București și Ilfov"
    subtitle="Cunoaștem bine terenul din zonă și știm la ce adâncimi să căutăm apă de calitate. Deplasare rapidă și garanție în scris."
    breadcrumb={[
      { label: 'Acasă', href: withBase('') },
      { label: 'Zone acoperite', href: withBase('zone-acoperite') },
      { label: 'București și Ilfov' },
    ]}
  />

  <section class="py-16 sm:py-20">
    <div class="wrap">
      <h2 class="text-3xl sm:text-4xl">Ce trebuie să știi despre zonă</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          localFacts.map((f) => (
            <div class="rounded-xl border border-border bg-surface p-6 shadow-sm">
              <div class="flex items-center gap-4">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-[10px] bg-secondary-soft text-2xl text-secondary">
                  <Icon name={f.icon} />
                </span>
                <h3 class="text-lg font-bold text-primary">{f.title}</h3>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-muted">{f.text}</p>
            </div>
          ))
        }
      </div>

      <h2 class="mt-16 text-3xl sm:text-4xl">Servicii oferite în zonă</h2>
      <CollapsibleCards label="Vezi toate serviciile" class="mt-8">
        <div data-collapse-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((s) => (
              <ServiceCard slug={s.id} title={s.data.title} icon={s.data.icon} excerpt={s.data.excerpt} />
            ))
          }
        </div>
      </CollapsibleCards>

      <div class="mt-16">
        <TrustBar />
      </div>
    </div>
  </section>

  <CtaBand title="Faci un puț în București sau Ilfov? Cere ofertă." />
</BaseLayout>
