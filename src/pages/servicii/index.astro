---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CollapsibleCards from '../../components/CollapsibleCards.astro';
import TrustBar from '../../components/TrustBar.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Servicii foraje puțuri apă"
  description="Servicii complete de foraje: puțuri apă, denisipări, pompe de căldură, mentenanță, avize, sisteme de pompare și multe altele."
>
  <PageHero
    eyebrow="Servicii"
    title="Servicii complete de foraje și puțuri"
    subtitle="De la forajul puțului până la punerea în funcțiune și documentație - o singură firmă pentru tot ce ai nevoie."
    breadcrumb={[{ label: 'Acasă', href: withBase('') }, { label: 'Servicii' }]}
  />

  <section class="py-16 sm:py-20">
    <div class="wrap">
      <CollapsibleCards label="Vezi toate serviciile">
        <div data-collapse-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((s) => (
              <ServiceCard slug={s.id} title={s.data.title} icon={s.data.icon} excerpt={s.data.excerpt} />
            ))
          }
        </div>
      </CollapsibleCards>
      <div class="mt-16">
        <TrustBar />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
